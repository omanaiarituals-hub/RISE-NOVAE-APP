import { notFound, redirect } from 'next/navigation'
import { createClient } from '@/lib/supabase/server'
import NovaLabClient from './NovaLabClient'

export const dynamic = 'force-dynamic'

function allowedEmails(): string[] {
  return (process.env.NOVA_V2_LAB_ALLOWED_EMAILS || '')
    .split(',')
    .map((email) => email.trim().toLowerCase())
    .filter(Boolean)
}

export default async function NovaLabPage() {
  if (process.env.NOVA_V2_LAB_ENABLED !== 'true') notFound()

  const supabase = await createClient()
  const {
    data: { user },
  } = await supabase.auth.getUser()

  if (!user) redirect('/login')

  const allowlist = allowedEmails()
  const email = user.email?.toLowerCase() || ''
  if (allowlist.length > 0 && !allowlist.includes(email)) notFound()

  return <NovaLabClient userEmail={user.email || ''} />
}
