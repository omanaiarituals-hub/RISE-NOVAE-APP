# -----------------------------------------------------------------------------
# NOVAÉ Finance — local / sandbox Powens, lecture seule
# -----------------------------------------------------------------------------
FINANCE_DEV_PREVIEW=true
FINANCE_DEV_PREVIEW_USER_ID=votre_uuid_supabase
FINANCE_PRIVATE_BETA_USER_IDS=votre_uuid_supabase

# disabled tant que Powens n'est pas configuré ; powens pour la sandbox.
FINANCE_BANKING_PROVIDER=disabled

# Powens — SERVEUR UNIQUEMENT. Jamais de NEXT_PUBLIC_.
# Accepte "mon-projet-sandbox" ou "mon-projet-sandbox.biapi.pro".
POWENS_DOMAIN=
POWENS_CLIENT_ID=
POWENS_CLIENT_SECRET=
POWENS_WEBVIEW_URL=https://webview.powens.com/connect

# Optionnel : IDs de connecteurs Powens à afficher dans la Webview.
# Pratique pour limiter le test à une institution de démonstration activée dans la sandbox.
POWENS_CONNECTOR_IDS=

# 32 octets ; 64 caractères hex ou base64.
FINANCE_CREDENTIAL_ENCRYPTION_KEY=
