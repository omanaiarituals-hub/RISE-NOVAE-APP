# -----------------------------------------------------------------------------
# NOVAÉ Finance — Lot 2 / Sandbox Powens, lecture seule
# -----------------------------------------------------------------------------

# Local uniquement : permet de tester les routes Finance même si le cookie
# Supabase local n'est pas présent après une auth OAuth faite sur le domaine prod.
FINANCE_DEV_PREVIEW=true
FINANCE_DEV_PREVIEW_USER_ID=votre_uuid_supabase

# En production : UUID autorisés séparés par des virgules.
FINANCE_PRIVATE_BETA_USER_IDS=votre_uuid_supabase

# Tant que la sandbox Powens n'est pas configurée : disabled.
# Après configuration du domaine sandbox : powens.
FINANCE_BANKING_PROVIDER=disabled

# Powens — SERVEUR UNIQUEMENT. Jamais de préfixe NEXT_PUBLIC_.
POWENS_DOMAIN=
POWENS_CLIENT_ID=
POWENS_CLIENT_SECRET=
POWENS_WEBVIEW_URL=https://webview.powens.com/connect

# 32 octets, 64 caractères hex ou base64.
# Exemple de génération PowerShell :
# -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
FINANCE_CREDENTIAL_ENCRYPTION_KEY=
